# The environment of the Compose stack (compose.yaml). Copy it to .env, or let `bash scripts/compose-init.sh` do it: it fills in the secrets that
# are empty here with generated values and sets UID and GID. .env stays on this machine (it is ignored by git); never commit it.
#
# Every secret below must be non-empty: `docker compose up` stops and names the one that is not.

# ─── Secrets (generated by compose-init.sh) ────────────────────────────────
MYSQL_ROOT_PASSWORD=
VERITMO_DB_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_RO_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# the token of the server: the dashboard and Prometheus use it to call the API
ORCHESTRATOR_TOKEN=
# the token the server gives the generators, and the one they ask for
MUSIC_TOKEN=
REDIS_PASSWORD=

# ─── Who writes the host folders ───────────────────────────────────────────
UID=1000
GID=1000

# ─── The folders of this machine (everything that is a file) ───────────────
# Each one can be on its own disk. Relative paths are relative to this folder.
PROJECTS_PATH=./compose-data/projects
# The media directory: set MEDIA_DIR=/media to keep whole projects there (the project folder then holds links, see docs/SERVER.md).
MEDIA_PATH=./compose-data/media
MEDIA_DIR=
MODELS_PATH=./compose-data/models
VOICES_PATH=./compose-data/voices
HYPERFRAMES_PATH=./compose-data/hyperframes
# the models of the Ollama of the `local-llm` profile
OLLAMA_PATH=./compose-data/ollama
# the programs and the third-party pieces the installer builds (bin/ and third_party/ inside)
INSTALL_PATH=./compose-data/install
# the keys the server keeps for the providers, and the library (characters, backgrounds, references, motions)
CONFIG_PATH=./compose-data/config

# ─── The server ────────────────────────────────────────────────────────────
# The address the server and Grafana are published on. 127.0.0.1 keeps them on this machine; another address exposes them (the server needs its token anyway).
BIND=127.0.0.1
SERVER_PORT=4666
GRAFANA_PORT=3000
# The origin the dashboard (dashboards-lab, outside this stack) is served from, allowed as a browser origin. Empty: no origin besides the server's own.
DASHBOARD_ORIGIN=
# Options added to the command line of the server. Empty: the server starts as it does by default.
SERVER_ARGS=
# The most RAM the server and what it launches may use.
SERVER_MEM_LIMIT=48g
# The edition of the program in the image: a Go build tag, empty for the default edition.
EDITION_TAG=

# ─── The installation step (docker compose --profile install run --rm installer) ──
# Components: required sd piper ytdlp gsap hflibs hfruntime; optional whisper demucs upscalers hfblocks models (see deploy/compose/install.sh).
# Empty: the default ones.
INSTALL_COMPONENTS=

# ─── The pieces of the other profiles ──────────────────────────────────────
# The card each music generator runs on (the `music` profile); with two cards, give each its own.
HEARTMULA_GPU=0
DIFFRHYTHM2_GPU=0
# The address of the Ollama the server uses. Empty: the one of the `local-llm` profile. Set it to use an Ollama somewhere else (and leave the profile off).
OLLAMA_HOST=

# ─── The database ──────────────────────────────────────────────────────────
VERITMO_DB_NAME=veritmo
VERITMO_DB_USER=mo

# ─── Which pieces start (profiles of compose.yaml) ─────────────────────────
# music: the HeartMuLa and DiffRhythm2 generators; local-llm: Ollama; logs: Loki and the shipper of the logs; redis: the Redis of the Monitoring card.
# Example: COMPOSE_PROFILES=music,local-llm
COMPOSE_PROFILES=

# The tag of the images and how long Prometheus keeps its data (the defaults)
#VERSION=dev
#PROMETHEUS_RETENTION=30d

# ─── Only for compose.services.yaml (the stack without the server) ──────────
# The ports the pieces are published on (on BIND) for the server that runs on this machine. These are the defaults; Ollama is on 11435 so it does not clash
# with an Ollama installed on this machine.
#MYSQL_PORT=3306
#HEARTMULA_PORT=8787
#DIFFRHYTHM2_PORT=8788
#OLLAMA_PORT=11435
#REDIS_PORT=6379
#LOKI_PORT=3100

