{
  "__inputs": [
    {
      "name": "DS_MYSQL",
      "label": "Veritmo MySQL",
      "description": "A user with SELECT on runs, run_samples and calibration_samples",
      "type": "datasource",
      "pluginId": "mysql",
      "pluginName": "MySQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "mysql",
      "name": "MySQL",
      "version": "1.0.0"
    }
  ],
  "title": "Veritmo",
  "uid": "veritmo-history",
  "tags": [
    "veritmo"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "${DS_MYSQL}"
        },
        "query": "SELECT DISTINCT server FROM runs WHERE server <> '' ORDER BY server",
        "definition": "SELECT DISTINCT server FROM runs WHERE server <> '' ORDER BY server",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs in the period",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS runs FROM runs r WHERE $__timeFilter(r.created_at) AND r.server IN (${server:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Succeeded",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS succeeded FROM runs r WHERE $__timeFilter(r.created_at) AND r.state='succeeded' AND r.server IN (${server:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Failed",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS failed FROM runs r WHERE $__timeFilter(r.created_at) AND r.state IN ('failed','interrupted') AND r.server IN (${server:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Average duration (s)",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT AVG(TIMESTAMPDIFF(SECOND, r.started_at, r.finished_at)) AS seconds FROM runs r WHERE $__timeFilter(r.created_at) AND r.state='succeeded' AND r.started_at IS NOT NULL AND r.server IN (${server:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Runs per server",
      "type": "barchart",
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(r.server,''),'(unnamed)') AS server, COUNT(*) AS runs FROM runs r WHERE $__timeFilter(r.created_at) AND r.server IN (${server:singlequote}) GROUP BY 1 ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 6,
      "title": "Runs per day and state",
      "type": "timeseries",
      "description": "Counts the runs created each day, by state.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(r.created_at,'1d'), r.state AS metric, COUNT(*) AS value FROM runs r WHERE $__timeFilter(r.created_at) AND r.server IN (${server:singlequote}) GROUP BY 1,2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "interrupted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Average duration per server (s)",
      "type": "timeseries",
      "description": "Succeeded runs only. Useful to compare one server with another.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(r.created_at,'1d'), COALESCE(NULLIF(r.server,''),'(unnamed)') AS metric, AVG(TIMESTAMPDIFF(SECOND, r.started_at, r.finished_at)) AS value FROM runs r WHERE $__timeFilter(r.created_at) AND r.state='succeeded' AND r.started_at IS NOT NULL AND r.server IN (${server:singlequote}) GROUP BY 1,2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "VRAM used per card (MB, maximum per minute)",
      "type": "timeseries",
      "description": "The server samples it while a run is in progress (every few seconds). There is no data outside runs: to see the machine while it is always on you need /metrics for Prometheus.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(s.ts,'1m'), CONCAT(COALESCE(NULLIF(r.server,''),'?'), ' · GPU ', s.gpu) AS metric, MAX(s.vram_used_mb) AS value FROM run_samples s JOIN runs r ON r.id = s.run_id WHERE $__timeFilter(s.ts) AND r.server IN (${server:singlequote}) GROUP BY 1,2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Measured speed of each card (1 = the reference card, 2 = twice as slow)",
      "type": "timeseries",
      "description": "How long each render or animation phase took compared with what was expected on the reference machine (RTX 5060 Ti).",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(c.`at`,'1d'), CONCAT(COALESCE(NULLIF(c.server,''),'?'), ' · ', c.gpu) AS metric, AVG(c.ratio) AS value FROM calibration_samples c WHERE $__timeFilter(c.`at`) AND c.server IN (${server:singlequote}) GROUP BY 1,2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Slowest runs",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.id AS run, r.project AS project, r.server AS server, TIMESTAMPDIFF(SECOND, r.started_at, r.finished_at) AS seconds FROM runs r WHERE $__timeFilter(r.created_at) AND r.state='succeeded' AND r.started_at IS NOT NULL AND r.server IN (${server:singlequote}) ORDER BY seconds DESC LIMIT 15",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Latest failures",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MYSQL}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.created_at AS created, r.id AS run, r.project AS project, r.server AS server, r.state AS state, LEFT(r.error, 200) AS error FROM runs r WHERE $__timeFilter(r.created_at) AND r.state IN ('failed','interrupted') AND r.server IN (${server:singlequote}) ORDER BY r.created_at DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
