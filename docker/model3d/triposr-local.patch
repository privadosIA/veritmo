 import numpy as np
 import torch
 import torch.nn as nn
-from torchmcubes import marching_cubes
+from skimage.measure import marching_cubes as _sk_marching_cubes
+
+
+def marching_cubes(vol: torch.Tensor, thresh: float):
+    # a CPU stand-in for torchmcubes (spike). skimage gives the vertices in the axis order of the volume (x, y, z); the code that
+    # calls this swaps the axes afterwards (it was written for torchmcubes, which gives (z, y, x)), so give them in that order and
+    # turn the faces round, which a reflection of the axes would have made inside out.
+    v, f, _, _ = _sk_marching_cubes(vol.detach().cpu().numpy(), level=thresh)
+    return torch.from_numpy(v[:, ::-1].copy()).float(), torch.from_numpy(f[:, ::-1].copy()).long()
 
 
 class IsosurfaceHelper(nn.Module):
